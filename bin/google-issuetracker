#!/usr/bin/env python3
"""Search Google's public issue trackers (Buganizer) anonymously.

Guarantees: one result per line -- "ISSUE-URL  MODIFIED  TITLE" -- newest
first as the server returns them; exit 1 when the search matched nothing
(grep semantics). Works against any Buganizer frontend host; no auth.

The wire format is positional JSPB, reverse-engineered 2026-08-09 from a
CDP capture (the endpoint rejects named-JSON bodies): request slot 5 is
an optional tracker-view filter, slot 6 is [query, page_token, count].
"""

import argparse
import datetime
import json
import urllib.request

JSON_PREFIX = ")]}'"


def build_request(query: str, tracker: str | None, count: int) -> list:
    return [None, None, None, None, None,
            [tracker] if tracker else None,
            [query, None, count]]


def parse_response(raw: str) -> list:
    """Rows of (issue_id, modified_unix_sec, title); [] when no matches."""
    assert raw.startswith(JSON_PREFIX), raw[:80]
    data = json.loads(raw.removeprefix(JSON_PREFIX))
    if isinstance(data, dict):  # server-side conversion/validation error
        raise SystemExit(f"tracker error: {data.get('message', data)}")
    issues = data[0][6][0]
    if issues is None:
        return []
    else:
        return [(row[1], row[4][0], row[2][5]) for row in issues]


def format_row(host: str, issue_id: int, modified: int, title: str) -> str:
    when = datetime.date.fromtimestamp(modified).isoformat()
    return f"https://{host}/issues/{issue_id}  {when}  {title}"


def fetch(host: str, body: list) -> str:
    req = urllib.request.Request(
        f"https://{host}/action/issues/list",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json",
                 "User-Agent": "Mozilla/5.0 (issuetracker-search)"},
    )
    with urllib.request.urlopen(req) as resp:
        return resp.read().decode()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("query", nargs="+", help="search terms (Buganizer query syntax)")
    parser.add_argument("--host", default="issuetracker.google.com",
                        help="also useful: issues.chromium.org")
    parser.add_argument("--tracker", default=None,
                        help="tracker-view id, e.g. 157 = Chromium; default: all public")
    parser.add_argument("-n", "--count", type=int, default=25)
    args = parser.parse_args()

    body = build_request(" ".join(args.query), args.tracker, args.count)
    rows = parse_response(fetch(args.host, body))
    for issue_id, modified, title in rows:
        print(format_row(args.host, issue_id, modified, title))
    return 0 if rows else 1


if __name__ == "__main__":
    raise SystemExit(main())
