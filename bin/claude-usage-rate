#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.13"
# dependencies = []
# ///
"""Compare current usage pace against the pace that would exactly land at
100% by reset, for each Claude usage-limit bucket (session, weekly, and any
per-model weekly scope).

Data source: GET https://api.anthropic.com/api/oauth/usage -- the same
undocumented endpoint the `/usage` slash command itself calls, authenticated
with the OAuth token Claude Code already stores at
~/.claude/.credentials.json. There is no public API for this; the shape may
change without notice.

`percent` is defined as usage since the window opened, so percent divided by
hours-elapsed-since-window-start is the exact average rate so far -- no
history or sampling needed.

Usage: claude-usage-rate
"""

import json
import sys
import urllib.error
import urllib.request
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from pathlib import Path

CREDENTIALS_PATH = Path.home() / ".claude" / ".credentials.json"
USAGE_API_URL = "https://api.anthropic.com/api/oauth/usage"
PERIOD_HOURS = {"session": 5, "weekly": 24 * 7}


class TokenExpired(Exception):
    pass


@dataclass(frozen=True)
class RateReport:
    label: str
    percent: float
    resets_at: datetime
    elapsed_hours: float
    remaining_hours: float
    current_rate: float
    avg_remaining_rate: float
    projected_percent: float

    @property
    def rate_change_needed(self) -> float:
        """% by which current_rate must change to land at exactly 100% by reset."""
        return (self.avg_remaining_rate / self.current_rate - 1) * 100


def load_token() -> str:
    creds = json.loads(CREDENTIALS_PATH.read_text())["claudeAiOauth"]
    expires_at = datetime.fromtimestamp(creds["expiresAt"] / 1000, tz=UTC)
    if expires_at < datetime.now(UTC):
        raise TokenExpired(f"expired at {expires_at}")
    return creds["accessToken"]


def fetch_usage(token: str) -> dict:
    request = urllib.request.Request(
        USAGE_API_URL,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.load(response)


def limit_label(limit: dict) -> str:
    scope = limit["scope"] or {}
    model = (scope.get("model") or {}).get("display_name")
    return f"{limit['group']} ({model})" if model else limit["group"]


def compute_rate_report(now: datetime, limit: dict) -> RateReport:
    resets_at = datetime.fromisoformat(limit["resets_at"])
    period_hours = PERIOD_HOURS[limit["group"]]
    window_start = resets_at - timedelta(hours=period_hours)
    elapsed_hours = (now - window_start).total_seconds() / 3600
    remaining_hours = (resets_at - now).total_seconds() / 3600
    percent = limit["percent"]
    current_rate = percent / elapsed_hours

    return RateReport(
        label=limit_label(limit),
        percent=percent,
        resets_at=resets_at,
        elapsed_hours=elapsed_hours,
        remaining_hours=remaining_hours,
        current_rate=current_rate,
        avg_remaining_rate=(100 - percent) / remaining_hours,
        projected_percent=percent + current_rate * remaining_hours,
    )


LABEL_W = 23  # widest label ("suggested rate change:") + 1
RATE_W = 7  # e.g. "35.1270"
HOUR_W = 6  # e.g. "149.2"
PCT_W = 5  # e.g. "16.8" / "+945"


def format_report(report: RateReport, *, show_window: bool = True) -> str:
    local_reset = report.resets_at.astimezone().strftime("%a %b %d %I:%M%p %Z")
    elapsed_note = f"  (over {report.elapsed_hours:{HOUR_W}.1f}h elapsed)" if show_window else ""
    remaining_note = f"  (over {report.remaining_hours:{HOUR_W}.1f}h remaining)" if show_window else ""
    lines = [
        f"{report.label}: {report.percent}% used, resets {local_reset}",
        f"  {'current rate:':<{LABEL_W}} {report.current_rate:{RATE_W}.4f} %/hr{elapsed_note}",
        f"  {'avg-remaining rate:':<{LABEL_W}} {report.avg_remaining_rate:{RATE_W}.4f} %/hr{remaining_note}",
        f"  {'projected at reset:':<{LABEL_W}} {report.projected_percent:{PCT_W}.1f}%",
        f"  {'suggested rate change:':<{LABEL_W}} {report.rate_change_needed:+{PCT_W}.0f}%",
    ]
    return "\n".join(lines)


def main() -> None:
    try:
        token = load_token()
    except TokenExpired as e:
        sys.exit(f"OAuth token expired ({e}) -- run any `claude` command to refresh it, then retry.")

    data = fetch_usage(token)
    assert "limits" in data, data
    limits = [limit for limit in data["limits"] if limit["resets_at"] is not None]

    now = datetime.now(UTC)
    reports = [compute_rate_report(now, limit) for limit in limits]

    # resets_at carries sub-second jitter across limits sharing one window (e.g. the two
    # weekly buckets), so dedup at minute resolution rather than exact equality.
    seen_resets: set[datetime] = set()
    formatted = []
    for report in reports:
        window_key = report.resets_at.replace(second=0, microsecond=0)
        show_window = window_key not in seen_resets
        seen_resets.add(window_key)
        formatted.append(format_report(report, show_window=show_window))
    print("\n\n".join(formatted))


if __name__ == "__main__":
    main()
