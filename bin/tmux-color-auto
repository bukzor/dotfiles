#!/bin/bash
# Give a tmux session a status-bar color no other session shows. The search
# starts from a palette slot hashed from host and session name, so a session
# keeps its color across restarts whenever that color is free.
#
# usage: tmux-color-auto [SESSION]   (default: the current session)
# ~/.tmux.conf runs this from its session-created and session-renamed hooks.
set -euo pipefail
shopt -s failglob
export DEBUG="${DEBUG:-0}"

onerror() {
  error="$?"
  echo >&2 "tmux-color-auto: ERROR($error)"
  exit "$error"
}
trap onerror ERR

# Dark backgrounds that carry bold white text.
PALETTE=(124 28 25 130 92 30 88 22 18 94 54 23)

if (( DEBUG > 0 )); then
  set -x
fi

target=()
if (( $# )); then
  target=(-t "=$1:")
fi
info=$(tmux display-message -p "${target[@]}" '#{session_id} #{host} #{session_name}')
id=${info%% *}
seed=${info#* }

# A session without a color of its own shows the global one, so it counts.
used=$(
  tmux list-sessions -f "#{!=:#{session_id},$id}" -F '#{status-style}' |
    sed -n 's/.*bg=colour\([0-9]*\).*/\1/p'
)

n=${#PALETTE[@]}
hash=$(sha256sum <<< "$seed")
start=$(( 16#${hash:0:8} % n ))
color=${PALETTE[start]}  # if every color is taken, share the hashed one
for (( i = 0; i < n; i++ )); do
  c=${PALETTE[(start + i) % n]}
  if ! grep -qx "$c" <<< "$used"; then
    color=$c
    break
  fi
done

tmux set -t "$id" status-style "bold,fg=white,bg=colour$color"
