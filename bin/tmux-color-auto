#!/usr/bin/env python3
"""Sticky tmux status-bar colors, one per session name.

usage:
  tmux-color-auto [SESSION]                 color SESSION (default: the current one)
  tmux-color-auto --if-uncolored [SESSION]  same, unless it has a color of its own
  tmux-color-auto --save [SESSION]          make SESSION's current color its sticky one
  tmux-color-auto --seed TEXT [SESSION]     re-roll SESSION's color with TEXT; save it

A session gets its saved color, from $XDG_CONFIG_HOME/tmux-color-auto.tsv
(default ~/.config), which the dotfiles repo carries across hosts. Lacking
one, it gets a cell of colortest's grid, picked by its name and that file
alone: the name rolls a row, then a column among the row's unvetoed cells,
and a cell a saved name claims passes the roll to the next free cell.
"""

import hashlib
import os
import subprocess
import sys
from collections.abc import Mapping
from pathlib import Path

COLUMNS = ("black", "red", "green", "yellow", "blue", "magenta", "cyan", "white")
# colortest's rows that color the whole bar, without their bold variants: bold
# doesn't tell sessions apart, and a bar left the terminal's background reads
# as missing. Terminal-theme colors, so they look native in any theme.
ROWS = (
    "fg=default,bg={}",
    "reverse,fg={},bg=default",
    "fg=default,bg=bright{}",
    "reverse,fg=bright{},bg=default",
)
# (row, column) cells that leave the bar black, or were seen unreadable in
# hterm's dark theme.
VETOED = frozenset({(0, 0), (1, 0), (2, 2), (2, 3), (3, 7)})
HEADER = ("session", "status-style")


def parse_saved(text: str) -> dict[str, str]:
    lines = text.splitlines()
    assert tuple(lines[0].split("\t")) == HEADER, lines[0]
    rows = [line.split("\t") for line in lines[1:] if line]
    assert all(len(row) == 2 for row in rows), rows
    return dict(rows)


def render_saved(saved: Mapping[str, str]) -> str:
    rows = [HEADER, *sorted(saved.items())]
    return "".join(f"{name}\t{style}\n" for name, style in rows)


def pick_style(name: str, saved: Mapping[str, str], seed: str = "") -> str:
    """The color rolled for name and seed: a function of those and of the
    colors saved for other names, alone.

    Every cell claimed: shares the rolled one.
    """
    key = f"{name}\0{seed}" if seed else name
    digest = hashlib.sha256(key.encode()).digest()
    row = int.from_bytes(digest[:8]) % len(ROWS)
    columns = [c for c in range(len(COLUMNS)) if (row, c) not in VETOED]
    column = columns[int.from_bytes(digest[8:16]) % len(columns)]
    cells = [
        (r, c)
        for r in range(len(ROWS))
        for c in range(len(COLUMNS))
        if (r, c) not in VETOED
    ]
    start = cells.index((row, column))
    styles = [ROWS[r].format(COLUMNS[c]) for r, c in cells[start:] + cells[:start]]
    claimed = {style for other, style in saved.items() if other != name}
    return next((style for style in styles if style not in claimed), styles[0])


def proc_tmux(*args: str) -> str:
    result = subprocess.run(
        ("tmux", *args), check=True, stdout=subprocess.PIPE, text=True
    )
    return result.stdout.rstrip("\n")


def load_saved(path: Path) -> dict[str, str]:
    try:
        text = path.read_text()
    except FileNotFoundError:
        return {}
    return parse_saved(text)


def save_saved(path: Path, saved: Mapping[str, str]) -> None:
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(render_saved(saved))
    tmp.replace(path)


def main(argv: list[str]) -> int:
    mode = argv[0] if argv[:1] and argv[0].startswith("-") else ""
    args = argv[1:] if mode else argv
    seed, args = (args[0], args[1:]) if mode == "--seed" and args else ("", args)
    if (
        mode not in ("", "--if-uncolored", "--save", "--seed")
        or len(args) > 1
        or (mode == "--seed" and not seed)
    ):
        print(__doc__, file=sys.stderr)
        return 2

    target = ("-t", f"={args[0]}:") if args else ()
    name = proc_tmux("display-message", "-p", *target, "#{session_name}")
    config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    path = config / "tmux-color-auto.tsv"
    saved = load_saved(path)
    own = proc_tmux("show-options", "-t", f"={name}:", "-v", "status-style")

    if mode == "--save" and own:
        save_saved(path, {**saved, name: own})
        return 0
    elif mode == "--save":
        print(
            f"tmux-color-auto: session {name!r} has no color of its own",
            file=sys.stderr,
        )
        return 1
    elif mode == "--seed":
        style = pick_style(name, saved, seed)
        proc_tmux("set-option", "-t", f"={name}:", "status-style", style)
        save_saved(path, {**saved, name: style})
        return 0
    elif mode == "--if-uncolored" and own:
        return 0
    else:
        style = saved.get(name) or pick_style(name, saved)
        proc_tmux("set-option", "-t", f"={name}:", "status-style", style)
        return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
