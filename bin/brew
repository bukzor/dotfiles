#!/bin/bash
set -eu

if [ -f /etc/alpine-release ]; then
  trap '[ $? = 0 ] || echo "brew: on Alpine, see ~/setup/alpine/homebrew.sh" >&2' EXIT
fi

BREWDIR=/opt/homebrew
BREW=$BREWDIR/bin/brew
# The installer uses /opt/homebrew on macOS and this prefix on Linux.
linuxbrew=/home/linuxbrew/.linuxbrew
if ! [ -d "$BREWDIR" ] && ! [ -d "$linuxbrew" ]; then
  if yesno "Homebrew is missing. Install homebrew?"; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  else
    echo 'Homebrew not installed.' >&2
    exit 1
  fi
fi
if ! [ -d "$BREWDIR" ] && [ -d "$linuxbrew" ]; then
  sudo ln -sf "$linuxbrew" -T "$BREWDIR"
fi

if ! [ -d "$BREWDIR" ]; then
  echo "Homebrew is still missing?!" >&2
  exit 1
fi

BEFORE="$BREWDIR/.before"
touch "$BEFORE"

$BREW "$@"

if [ "$BREWDIR/opt" -nt "$BEFORE" ] || [ "$BREWDIR/Cellar" -nt "$BEFORE" ]; then
  brew-handle-gnubin
fi
